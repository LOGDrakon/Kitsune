    <!-- Inspiration wizard: exploration mode (2026-08-24) -->
    <string name="inspiration_wizard_mode_title">How would you like to find your idea?</string>
    <string name="inspiration_wizard_mode_interview_title">Answer a few questions</string>
    <string name="inspiration_wizard_mode_interview_body">Four short questions about what you feel like. Best when you roughly know what you want.</string>
    <string name="inspiration_wizard_mode_explore_title">Explore proposals</string>
    <string name="inspiration_wizard_mode_explore_body">Describe it vaguely, then pick the idea you like best. Each round narrows it down. Best when you have no idea yet.</string>
    <string name="inspiration_wizard_brief_title">What are you vaguely after?</string>
    <string name="inspiration_wizard_brief_hint">A few words are enough. You will refine by picking, not by writing.</string>
    <string name="inspiration_wizard_brief_placeholder">e.g. someone who annoys me but that I cannot avoid</string>
    <string name="inspiration_wizard_brief_submit">Show me some ideas</string>
    <string name="inspiration_wizard_loading_sketches">Coming up with ideas…</string>
    <string name="inspiration_wizard_sketch_title">Which one is closest?</string>
    <string name="inspiration_wizard_sketch_hint">Pick the one you like best. Say what to change, and you will get new ideas around it.</string>
    <string name="inspiration_wizard_sketch_note_label">What would you change? (optional)</string>
    <string name="inspiration_wizard_sketch_note_placeholder">e.g. older, and less sure of herself</string>
    <string name="inspiration_wizard_sketch_refine">Closer, but…</string>
    <string name="inspiration_wizard_sketch_build">Take this one</string>
    <string name="inspiration_wizard_sketch_last_round">Last round — pick the one you want to build.</string>
